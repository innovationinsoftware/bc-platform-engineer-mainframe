//IBMUSERL JOB ,'MAKE CHUMP LIBS',
//            CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//            NOTIFY=&SYSUID
//         JCLLIB ORDER=(IBMUSER.CHUMP.BASE)
//********************************************************************
//* THIS IS TO SET UP LIBRARIES FOR STUDENTS TO USE AS THE BASIS FOR
//* BUILDING A SYSMOD TO INSTALL CHUMP. IT IS NOT ITSELF PART OF THE
//* CHUMP DEVELOPMENT ENVIRONMENT OR CHUMP DISTRIBUTION.
//*
//* DEVELOPMENT  DISTRIBUTION
//*
//* JCLLIB                     JCL FOR SUBMISSION
//* PROCLIB                    JCL PROCEDURES
//* SRCLIB                     APPLICATION PROGRAM SOURCE
//* SAMPLIB      SAMPLIB       DOCUMENTATION AND EXAMPLES
//* PROGLIB      PROGLIB       PDSE LIBRARY FOR PROGRAM OBJECTS
//*
//* DEVELOPMENT LIBRARIES ARE LOADED WITH MEMBERS TO HELP STUDENTS
//* GET STARTED. DISTIBUTION LIBRARIES ARE LEFT EMPTY. STUDENTS WILL
//* POPULATE THEM AS THEY COMPLETE LAB EXERCISES RELATED TO SMP/E.
//*
//* THIS JOB MUST BE SUBMITTED UNDER A USERID THAT HAS THE AUTHORITY
//* TO ALLOCATE DATA SETS UNDER DIFFERENT HLQ'S THAN ITSELF.
//********************************************************************
//*
//    SET HLQ=PLAT01  <= LIBRARIES TO BE ALLOCATED UNDER THIS USERID
//*
//********************************************************************
//* CATALOG A MODEL DSCB FOR A LIBRARY (PDSE) FOR 80-BYTE SOURCE
//********************************************************************
//CLEANUP  EXEC PGM=IEFBR14
//DCBSRC   DD DSN=&HLQ..MODELDCB.DCBLIB80,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,VOL=SER=USRVS1,
//            SPACE=(TRK,(0)),
//            DSNTYPE=LIBRARY,
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//ALLOC    EXEC PGM=IEFBR14
//DCBSRC   DD DSN=&HLQ..MODELDCB.DCBLIB80,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,VOL=SER=USRVS1,
//            SPACE=(TRK,(0)),
//            DSNTYPE=LIBRARY,
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//********************************************************************
//* CATALOG A MODEL DSCB FOR A LIBRARY (PDSE) FOR PROGRAM OBJECTS
//********************************************************************
//CLEANUP  EXEC PGM=IEFBR14
//DCBPROG  DD DSN=&HLQ..MODELDCB.DCBPLIB,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,VOL=SER=USRVS1,
//            SPACE=(TRK,(0)),
//            DSNTYPE=LIBRARY,
//            DCB=(DSORG=PO,RECFM=U,LRECL=0,BLKSIZE=4096)
//ALLOC    EXEC PGM=IEFBR14
//DCBPROG  DD DSN=&HLQ..MODELDCB.DCBPLIB,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,VOL=SER=USRVS1,
//            SPACE=(TRK,(0)),
//            DSNTYPE=LIBRARY,
//            DCB=(DSORG=PO,RECFM=U,LRECL=0,BLKSIZE=4096)
//********************************************************************
//* ALLOCATE SOURCE LIBRARIES FOR CHUMP DEVELOPMENT
//********************************************************************
//DEVJCL   EXEC MAKELIB,LIBNAME=&HLQ..CHUMP.DEV.JCLLIB
//DEVPROC  EXEC MAKELIB,LIBNAME=&HLQ..CHUMP.DEV.PROCLIB
//DEVSRC   EXEC MAKELIB,LIBNAME=&HLQ..CHUMP.DEV.SRCLIB
//DEVSAMP  EXEC MAKELIB,LIBNAME=&HLQ..CHUMP.DEV.SAMPLIB
//DISTSAMP EXEC MAKELIB,LIBNAME=&HLQ..CHUMP.DIST.SAMPLIB
//********************************************************************
//* SEED SOURCE LIBRARIES WITH CURRENT BASE MEMBERS
//********************************************************************
//SEEDJCL   EXEC PGM=IEBCOPY,COND=(0,GT)
//SYSPRINT  DD SYSOUT=*
//SYSOUT    DD SYSOUT=*
//BASELIB   DD DSN=IBMUSER.CHUMP.BASE,DISP=SHR
//DEVJCL    DD DSN=&HLQ..CHUMP.DEV.JCLLIB,DISP=SHR
//DEVPROC   DD DSN=&HLQ..CHUMP.DEV.PROCLIB,DISP=SHR
//DEVSRC    DD DSN=&HLQ..CHUMP.DEV.SRCLIB,DISP=SHR
//DEVSAMP   DD DSN=&HLQ..CHUMP.DEV.SAMPLIB,DISP=SHR
//SYSIN     DD *
COPYOPER COPY OUTDD=DEVJCL,INDD=BASELIB
         SELECT MEMBER=(YYZBDJCL)
COPYOPER COPY OUTDD=DEVPROC,INDD=BASELIB
         SELECT MEMBER=(YYZBUILD)
COPYOPER COPY OUTDD=DEVSRC,INDD=BASELIB
         SELECT MEMBER=(YYZGREET,YYZSETCC)
COPYOPER COPY OUTDD=DEVSAMP,INDD=BASELIB
         SELECT MEMBER=($INFO,DMOGREET,DMOSETCC)
