//IBMUSERC JOB ,'SAMPLE SETCC',
//         CLASS=A,MSGCLASS=X,
//         MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*********************************************************************
//* YYZSETCC PERFORMS NO PROCESSING BUT ONLY SETS THE CONDITION CODE
//* TO THE VALUE SPECIFIED IN THE EXEC STATEMENT PARM= PARAMETER.
//*
//* DEFAULT IF NO PARM IS PASSED: COND CODE 0000
//* DEFAULT IF INVALID PARM IS PASSED: COND CODE 0000 OR ABEND
//*
//* USAGE
//*
//* //STEPX EXEC PGM=YYZSETCC,PARM='CC=1234'
//*********************************************************************
//JOBLIB   DD  DSN=&SYSUID..PROGLIB,DISP=SHR
//*
//* NO PARM PASSED - EXPECT COND CODE 0000
//NOPARM   EXEC PGM=YYZSETCC
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* CC=0009 - EXPECT COND CODE 0009
//COND9    EXEC PGM=YYZSETCC,PARM='CC=0009'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* CC=0013 - EXPECT COND CODE 0013
//COND13   EXEC PGM=YYZSETCC,PARM='CC=0013'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* MALFORMED PARM PASSED - EXPECT ABEND, MAYBE COND CODE 0000
//MALFORMD EXEC PGM=YYZSETCC,PARM='CCC=4040'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
