//********************************************************************
//DEVPROG  EXEC MAKEPLIB,LIBNAME=&HLQ..CHUMP.DEV.PROGLIB,
//           PRI=4,SEC=2
//DISTPROG EXEC MAKEPLIB,LIBNAME=&HLQ..CHUMP.DIST.PROGLIB,
//           PRI=4,SEC=2
