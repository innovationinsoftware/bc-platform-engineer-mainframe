//*********************************************************************
//* ASSEMBLE AND LINK-EDIT A CHINDOGU UTILITY MEGA-PACK PROGRAM.
//* CHUMP V1R0M0
//*
//* SYMBOLS
//*
//* &HLQ            HIGH-LEVEL QUALIFIER FOR DATA SETS
//* &PROG           SOURCE AND PROGRAM LIBRARY MEMBER NAME
//*
//* DATA SET NAMES
//*
//* HLQ.CHUMP.DEV.SRCLIB        SOURCE LIB FOR DEVELOPMENT
//* HLQ.CHUMP.DEV.PROGLIB       PROGRAM LIB FOR DEVELOPMENT
//*
//* USAGE
//*
//* //      SET HLQ=&SYSUID
//* //BUILD EXEC YYZBUILD
//*
//* ACTIONS
//*
//* BUILDS CHUMP SOURCES IN &HLQ..CHUMP.DEV.SRCLIB AND PLACES PROGRAM
//* OBJECTS IN &HLQ..CHUMP.DEV.PROGLIB.
//*********************************************************************
//YYZBUILD PROC
//*
//ASM      EXEC PGM=ASMA90,REGION=0M
//SYSPRINT DD SYSOUT=*
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSIN    DD DSN=&HLQ..DEV.SRCLIB(&PROG),
//            DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(MOD,PASS),
//            SPACE=(TRK,(1,1))
//*
//LKED     EXEC PGM=IEWL,REGION=0M
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..DEV.PROGLIB(&PROG),
//            DISP=SHR
//         PEND
