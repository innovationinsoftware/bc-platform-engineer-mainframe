
/* REXX */
  "EXECIO * DISKR INODES(STEM INP. FINIS"
  UPDATE = 'NO'
  IF MVSVAR('SYMDEF','TCPHOSTNAME_') = 'K2_TCPHOSTNAME_PH' THEN
  DO
    EXIT
  END
  DO LP = 1 TO INP.0
    PARSE VAR INP.LP VAR1 VAR2 REST
    IF VAR1 = '&HOMEIPADDRESS1' THEN
    DO
      VAR1 = MVSVAR('SYMDEF','HOMEIPADDRESS1')
      UPDATE = 'YES'
    END
    IF VAR2 = '&TCPHOSTNAME_&TCPDOMAIN_' THEN
    DO
      VAR2 = MVSVAR('SYMDEF','TCPHOSTNAME_')
      VAR2 = VAR2||"."||MVSVAR('SYMDEF','TCPDOMAIN_')
      UPDATE = 'YES'
    END
    IF VAR2 = '&TCPHOSTNAME_' THEN
    DO
      VAR2 = MVSVAR('SYMDEF','TCPHOSTNAME_')
      UPDATE = 'YES'
    END
    INP.LP = VAR1 VAR2 REST
  END
  IF UPDATE = 'YES' THEN
  DO
    "EXECIO * DISKW INODES(STEM INP. FINIS"
  END
EXIT
