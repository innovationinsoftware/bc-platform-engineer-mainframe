//IBMUSERG JOB ,'SAMPLE GREET',
//         CLASS=A,MSGCLASS=X,
//         MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*********************************************************************
//* YYZGREET WRITES A SINGLE RECORD TO DDNAME CHUMPOUT CONTAINING THE
//* WORD 'HELLO' IN THE LANGUAGE SPECIFIED ON THE EXEC STATEMENT PARM.
//*
//* DEFAULT IF NO PARM IS PASSED: ENGLISH
//* DEFAULT IF INVALID PARM IS PASSED: ENGLISH
//* DEFAULT IF UNSUPPORTED LANGUAGE CODE IS PASSED: ENGLISH
//*
//* USAGE
//*
//* //STEPX EXEC PGM=YYZGREET,PARM='LANG=DE'
//*
//* SUPPORTED LANGUAGES:
//*   DE  GERMAN
//*   EN  ENGLISH
//*   ES  SPANISH
//*   JP  JAPANESE (ROMAJI)
//*   ZH  MANDARIN (PINYIN)
//*********************************************************************
//JOBLIB   DD  DSN=&SYSUID..PROGLIB,DISP=SHR
//*
//* NO PARM PASSED - EXPECT ENGLISH
//NOPARM   EXEC PGM=YYZGREET
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* MALFORMED PARM PASSED - EXPECT ENGLISH
//MALFORMD EXEC PGM=YYZGREET,PARM='LONG=ES'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* UNSUPPORTED LANGUAGE CODE - EXPECT ENGLISH
//UNSUPPRT EXEC PGM=YYZGREET,PARM='LANG=FR'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* LANGUAGE CODE DE - EXPECT GERMAN
//DE       EXEC PGM=YYZGREET,PARM='LANG=DE'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* LANGUAGE CODE EN - EXPECT ENGLISH
//EN       EXEC PGM=YYZGREET,PARM='LANG=EN'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* LANGUAGE CODE ES - EXPECT SPANISH
//ES       EXEC PGM=YYZGREET,PARM='LANG=ES'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* LANGUAGE CODE JP - EXPECT JAPANESE
//JP       EXEC PGM=YYZGREET,PARM='LANG=JP'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//*
//* LANGUAGE CODE ZH - EXPECT MANDARIN
//ZH       EXEC PGM=YYZGREET,PARM='LANG=ZH'
//CHUMPOUT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
